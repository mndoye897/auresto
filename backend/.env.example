PORT=4000
DATABASE_URL=postgresql://admin:admin123@localhost:5432/auresto

# Required for Owner Dashboard (never expose in frontend)
OWNER_SECRET=change_me_to_a_long_random_secret

# Optional: default grace period in days for expired subscriptions
DEFAULT_GRACE_PERIOD_DAYS=3

# Google Sign-In (public client ID — safe in frontend; server uses for token verification)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Wave Business API — configure when credentials are received (server-side only)
# WAVE_API_KEY=
# WAVE_WEBHOOK_SECRET=
# WAVE_API_BASE=https://api.wave.com/v1

# Unsplash (server-side only)
# UNSPLASH_ACCESS_KEY=
