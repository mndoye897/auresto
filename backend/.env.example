PORT=4000
DATABASE_URL=postgresql://admin:admin123@localhost:5432/auresto

# Required for Owner Dashboard (never expose in frontend)
OWNER_SECRET=change_me_to_a_long_random_secret

# Optional: default grace period in days for expired subscriptions
DEFAULT_GRACE_PERIOD_DAYS=3

# Google Sign-In (public client ID — safe in frontend; server uses for token verification)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Wave Business API — configure when credentials are received (server-side only)
# WAVE_API_KEY=
# WAVE_WEBHOOK_SECRET=
# WAVE_API_BASE=https://api.wave.com/v1

# DexPay — sandbox par défaut. Ne copiez jamais de clés dans le frontend ou Git.
# Utilisez de nouvelles clés TEST après avoir révoqué toute clé exposée.
# DEXPAY_MODE=sandbox
# DEXPAY_API_KEY=pk_test_votre_cle_publique
# DEXPAY_WEBHOOK_SECRET=sk_test_votre_cle_secrete
# AURESTO_APP_URL=https://votre-frontend.example
# DEXPAY_WEBHOOK_URL=https://votre-backend.example/api/payments/dexpay/webhook
# Pour passer en production uniquement après validation complète :
# DEXPAY_MODE=live
# DEXPAY_API_KEY=pk_live_votre_cle_publique
# DEXPAY_WEBHOOK_SECRET=sk_live_votre_cle_secrete

# Unsplash (server-side only)
# UNSPLASH_ACCESS_KEY=

# Marketing AI (server-side only — never expose to the frontend)
# AI_PROVIDER=gemini
# AI_MODEL=gemini-flash-latest
# GEMINI_API_KEY=your_gemini_api_key
# AI_MAX_OUTPUT_TOKENS=2500
# AI_TIMEOUT_MS=30000
